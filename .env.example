# FinRAG reads this file from the repository root.

# Required for Gemini-generated research synthesis. Market data and news
# collection can still run without a key, but Gemini will not generate a report.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key

# Optional. If a valid key is present, the indexing pipeline uses OpenAI
# embeddings and OpenAI summarization. Leave blank to use the local Hugging Face
# embedding and summarization models instead.
OPENAI_API_KEY=
FINRAG_EMBEDDING_MODEL=text-embedding-3-small

# Optional enhanced PDF parsing. Without this key, indexing uses PyPDF2.
LLAMA_CLOUD_API_KEY=

# Local RAG settings. The persistence path is fixed by the application at
# finrag_tree/chroma_vectorstore; this controls its Chroma collection name.
FINRAG_USE_CHROMADB=true
FINRAG_CHROMA_COLLECTION=finrag_embeddings

# Optional Langfuse observability; leave commented out to disable it.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
